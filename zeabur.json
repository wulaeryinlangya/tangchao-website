{
  "name": "tangchao-website",
  "services": [
    {
      "name": "frontend",
      "type": "static",
      "buildCommand": "npm install && npm run build",
      "outputDirectory": "dist",
      "installCommand": "npm install",
      "framework": "vite"
    },
    {
      "name": "backend",
      "type": "nodejs",
      "buildCommand": "cd server && npm install",
      "startCommand": "node server/server.js",
      "rootDirectory": ".",
      "port": 3001,
      "env": {
        "NODE_ENV": "production"
      }
    }
  ]
}
